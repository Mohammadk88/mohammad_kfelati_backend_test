generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientAppointments Appointment[] @relation("PatientAppointments")
  doctorAppointments  Appointment[] @relation("DoctorAppointments")
}

model Appointment {
  id        String            @id @default(uuid())
  patientId String
  doctorId  String
  dateTime  DateTime
  endTime   DateTime
  duration  Int               @default(30)
  status    AppointmentStatus @default(SCHEDULED)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient User @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Restrict)
  doctor  User @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([doctorId, status, dateTime])
  @@index([patientId, status, dateTime])
}